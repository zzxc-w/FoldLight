{
  "name": "foldlight",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": { "three": "^0.180.0" },
  "devDependencies": { "@types/three": "^0.180.0", "vite": "^7.1.7", "typescript": "^5.9.3", "tsx": "^4.20.6", "@playwright/test": "^1.56.1" }
}
